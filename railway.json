{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "dotnet publish -c Release --output /app/publish"
  },
  "deploy": {
    "numReplicas": 1,
    "startCommand": "dotnet /app/publish/DotnetStarterKit.dll",
    "healthcheckPath": "/api/v1/health",
    "restartPolicyType": "ON_FAILURE"
  }
}
